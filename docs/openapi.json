    },
    "/uploads": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "byteSize",
                  "contentType",
                  "sha256"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "byteSize": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "contentType": {
                    "type": "string",
                    "pattern": "^[a-z]+/[a-z0-9.+-]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
