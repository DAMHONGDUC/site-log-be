    "/sync/push": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mutations"
                ],
                "properties": {
                  "mutations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "table",
                        "id",
                        "op",
                        "clientUpdatedAt",
                        "fields"
                      ],
                      "properties": {
                        "table": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "op": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "upsert"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "delete"
                              ]
                            }
                          ]
                        },
                        "clientUpdatedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "fields": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      }
                    },
                    "minItems": 1,
                    "maxItems": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
