{
  "name": "site-log-be",
  "version": "0.1.0",
  "description": "Site Log backend: sync, uploads, realtime and team API for the iOS and Android apps",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "dev:all": "bash scripts/dev-up.sh",
    "dev:stop": "bash scripts/dev-down.sh",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "s3:bucket": "tsx --env-file-if-exists=.env scripts/s3-bucket.ts",
    "token": "tsx --env-file-if-exists=.env scripts/dev-token.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "move-keys": "tsx --env-file-if-exists=.env scripts/move-keys.ts",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DAMHONGDUC/site-log-be.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/DAMHONGDUC/site-log-be/issues"
  },
  "homepage": "https://github.com/DAMHONGDUC/site-log-be#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/client-sesv2": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/websocket": "^11.3.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
